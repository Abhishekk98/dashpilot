# Copy to backend/.env and fill in values. Never commit the real .env.
# Only use public/sample datasets during development (free-tier AI may use prompts for training).

# AI provider: gemini (now) or claude (later)
LLM_PROVIDER=gemini

# Free key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Leave empty for the default (gemini-3.6-flash)
GEMINI_MODEL=

# Only needed when LLM_PROVIDER=claude
ANTHROPIC_API_KEY=
# Leave empty for the default (claude-opus-5-5)
CLAUDE_MODEL=

# Frontend origin(s) allowed to call this API, comma separated
CORS_ORIGINS=http://localhost:3000

# Optional
# STORAGE_DIR=./storage
# MAX_UPLOAD_MB=100
# LLM_MAX_RETRIES=4
