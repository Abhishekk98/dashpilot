      "fontSize": 9
    },
    "rowHeaders": {
      "fontColor": "{{text}}",
      "backColor": "{{card}}",
      "fontFamily": "Segoe UI",
      "fontSize": 9
    },
    "values": {
      "fontColorPrimary": "{{text}}",
      "backColorPrimary": "{{card}}",
      "fontFamily": "Segoe UI",
      "fontSize": 9
    }
  }
}
