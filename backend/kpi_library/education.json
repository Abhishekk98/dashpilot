      "fallback": "count_rows"
    },
    {
      "name": "Enrolments",
      "kind": "count_rows",
      "format": "decimal",
      "description": "Number of enrolment records."
    },
    {
      "name": "Average Score",
      "kind": "average",
      "format": "decimal",
      "description": "Average score or marks.",
      "columns": "score|marks|grade_points|gpa|percentage"
    },
    {
      "name": "Pass Rate",
      "kind": "value_rate",
      "format": "percent",
      "description": "Share of results that passed.",
      "columns": "result|status|outcome",
      "values": "pass"
    },
    {
      "name": "Pass Rate (Flag)",
      "kind": "flag_rate",
      "format": "percent",
      "description": "Share of students flagged as passed.",
      "columns": "passed|is_pass"
    },
    {
      "name": "Average Attendance",
      "kind": "average",
      "format": "percent",
      "description": "Average attendance.",
      "columns": "attendance"
    }
  ]
}
